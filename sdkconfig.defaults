# Timing / RTOS
CONFIG_FREERTOS_HZ=1000

# Power management
# Automatic light sleep when idle (tickless idle)
# CPU sleeps during FreeRTOS idle, wakes on BLE/timer/GPIO events
# Note: light sleep requires BT modem sleep (CONFIG_BTDM_CTRL_MODEM_SLEEP=y,
# already enabled by default for NimBLE on ESP32)
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=n
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3

# Logging - ERROR only for production (less UART traffic, better radio timing)
# CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=2
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_BOOTLOADER_LOG_LEVEL=1
# Disable verbose component logging
CONFIG_LOG_MAXIMUM_LEVEL_ERROR=y
CONFIG_LOG_MAXIMUM_LEVEL=1

# BLE / NimBLE (explicit for reproducible defaults)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
# end of Bluetooth

# Disable Brownout Detector
CONFIG_ESP_BROWNOUT_DET=n

# OTA (wireless firmware update)
# Custom partition table with ota_0/ota_1 slots (see partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y
# Bootloader rollback: a new OTA image must confirm itself within 60 s
# of uptime (see ota_confirm_task in main.c), otherwise the bootloader
# reverts to the previous working image on next reboot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
